{
  "_comment": "Fixture registry for the ats-search tests. Never read at runtime.",
  "defaults": {
    "allowed_countries": [
      "CH",
      "DE",
      "AT"
    ],
    "remote_regions": [
      "europe",
      "eu",
      "dach",
      "emea"
    ],
    "cities": [
      "Zurich",
      "Zug",
      "Geneva",
      "Lausanne",
      "Berlin",
      "Munich",
      "Vienna"
    ],
    "title_include": [
      "engineer",
      "developer",
      "scientist",
      "ml",
      "machine learning",
      "ai",
      "nlp",
      "llm",
      "software",
      "backend",
      "full stack",
      "data",
      "research",
      "intern"
    ],
    "title_exclude": [
      "principal",
      "staff",
      "director",
      "head of",
      "vp",
      "chief",
      "thesis",
      "apprentice",
      "ausbildung",
      "sales",
      "recruiter"
    ],
    "conditional_exclude": [
      {
        "pattern": "werkstudent|working student|studentische",
        "unless_country": [
          "CH"
        ],
        "why": "Swiss working-student roles are viable; DE/AT ones need local enrolment."
      }
    ],
    "cadence_days": {
      "1": 1,
      "2": 1,
      "3": 3,
      "4": 7,
      "5": 14
    },
    "min_interval_minutes": 0,
    "vendor_access": {
      "smartrecruiters": {
        "enabled": true,
        "robots": "test-override"
      }
    }
  },
